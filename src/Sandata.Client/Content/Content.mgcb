
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#

#---------------------------------- Content ---------------------------------#

# Sandata v0.1 ships no font, sprite, or audio content through the MonoGame
# content pipeline yet (design section 11: "the content pipeline ships fonts
# only", and no font task exists for Sandata before plan task 33). This file
# exists so `dotnet build` has a valid, empty MGCB document for
# MonoGame.Content.Builder.Task to process; it intentionally declares zero
# #begin blocks. The theme catalog JSON that SandataGame reads at run time
# (Content/Themes/sandata-theme-standards.json) ships as a plain copied file
# through Sandata.Client.csproj's own CopyToOutputDirectory rule, not through
# this pipeline — it is data the client parses itself, not an asset MonoGame's
# content pipeline needs to process.
