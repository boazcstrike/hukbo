
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#

#---------------------------------- Content ---------------------------------#

# Sandata ships two fonts through the MonoGame content pipeline (plan task 33):
# Body for HUD row content and Label for panel headers, both baked from the
# vendored Rajdhani SemiBold face in Fonts/Rajdhani-SemiBold.ttf. See
# Fonts/README.md for the size ramp and why Sandata needs only these two
# rungs, and Theming/SandataFontRamp.cs for the pure asset-id/pixel-size
# source of truth these #begin blocks must stay in sync with. The theme
# catalog JSON that SandataGame reads at run time
# (Content/Themes/sandata-theme-standards.json) still ships as a plain copied
# file through Sandata.Client.csproj's own CopyToOutputDirectory rule, not
# through this pipeline — it is data the client parses itself, not an asset
# MonoGame's content pipeline needs to process.

#begin Fonts/SandataBody.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Color
/build:Fonts/SandataBody.spritefont

#begin Fonts/SandataLabel.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Color
/build:Fonts/SandataLabel.spritefont

# The two weapon sprites go through the pipeline rather than being read as raw
# PNG at run time, and the reason is the one processor parameter below.
# SpriteBatch draws with premultiplied alpha by default, and Texture2D.FromStream
# does not premultiply — a straight-alpha PNG loaded that way fringes dark
# around every edge. Letting the processor premultiply once, at build time, is
# what keeps a rotated weapon silhouette clean against the arena surface.
# Both sprites are greyscale plus alpha and are tinted by a theme role at draw
# time; see Sprites/README.md for the pixel contract, including that they point
# along +X and rotate about a recorded grip anchor.

#begin Sprites/weapon-rifle.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyEnabled=False
/processorParam:GenerateMipmaps=False
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Color
/build:Sprites/weapon-rifle.png

#begin Sprites/weapon-pistol.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyEnabled=False
/processorParam:GenerateMipmaps=False
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Color
/build:Sprites/weapon-pistol.png
